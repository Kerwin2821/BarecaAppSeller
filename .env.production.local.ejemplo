# ─────────────────────────────────────────────────────────────
#  PLANTILLA — copiar a  .env.production.local  (ese SÍ se ignora en git)
#  Contiene los SECRETOS de producción. Nunca commitear el archivo real.
# ─────────────────────────────────────────────────────────────

# Clave del login móvil sin captcha (APP_LOGIN_KEY del BFF de PRODUCCIÓN).
# ⚠️ PENDIENTE: pedirla al equipo que administra el BFF. Sin ella el login da 401.
EXPO_PUBLIC_APP_KEY=PENDIENTE_PEDIR_A_BFF

# Si producción usa otro proyecto Firebase, descomentar:
# EXPO_PUBLIC_FIREBASE_API_KEY=...
