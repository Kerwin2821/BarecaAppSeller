{
  "expo": {
    "name": "BARECA Vendedores",
    "slug": "bareca-vendedores",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "barecavendedores",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2470"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bareca.vendedores",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.bareca.vendedores",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "BARECA Vendedores usa tus fotos para leer la cédula y el carnet de circulación.",
          "cameraPermission": "BARECA Vendedores usa la cámara para capturar la cédula y el carnet de circulación.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BARECA Vendedores usa tu ubicación para autoseleccionar el estado, municipio y ciudad del asegurado.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2A2F6B"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BARECA Vendedores usa la cámara para capturar la cédula y el carnet de circulación.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BARECA Vendedores usa Face ID para desbloquear el app e iniciar sesión sin escribir la clave."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseCocoaPods.js",
      "./plugins/withManualSigning.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f1ce501-2be5-454b-a8b8-9c8f1ead7fb6"
      }
    }
  }
}
