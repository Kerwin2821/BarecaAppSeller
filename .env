# Ambiente al que apunta el app (QA por ahora).
# El app consume el BFF de Bareca (no los backends Java directo).
# QA:   https://qaasesores.barecaonline.com   (BFF bff-polizas-claude)
# PROD: https://asesores.barecaonline.com      (BFF bff-polizas-nuevo :3010)
EXPO_PUBLIC_BFF_URL=https://qaasesores.barecaonline.com

# Identificador del portal ante el BFF (igual que el authInterceptor de la web:
# `X-Portal-Id: VENDEDORES`). NO es `x-app-name` (ese es del flujo público).
EXPO_PUBLIC_PORTAL_ID=VENDEDORES

# Sitekey de Cloudflare Turnstile del portal QA (captcha del login).
# Es pública por diseño (va en el HTML del sitio); no es un secreto.
EXPO_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAACd-1uO91ziroUoi

# Dominio con el que se renderiza Turnstile en el WebView (debe estar en el
# allowlist del widget en Cloudflare). Usamos el propio dominio QA del portal.
EXPO_PUBLIC_TURNSTILE_HOST=https://qaasesores.barecaonline.com
