# ─────────────────────────────────────────────────────────────
#  PRODUCCIÓN  —  ⚠️ DINERO REAL
#  Solo se usa cuando se compila con NODE_ENV=production.
#  Sin esa variable, Expo carga .env (QA) y el app cobra 1 Bs.
#  Aquí NO van secretos: la clave del login va en .env.production.local
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_BFF_URL=https://asesores.barecaonline.com
EXPO_PUBLIC_PORTAL_CLIENTE_URL=https://portal.bareca.com
EXPO_PUBLIC_PORTAL_ID=VENDEDORES

# ⚠️ true = cada emisión cobra el MONTO REAL al cliente (no 1 Bs).
EXPO_PUBLIC_MONTO_REAL=true

EXPO_PUBLIC_CHANNEL_ID=aaec98eb-add7-4f39-bec8-1fe8a8409862
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bareca-d9254
# EXPO_PUBLIC_FIREBASE_API_KEY  → confirmar si producción usa otro proyecto Firebase
